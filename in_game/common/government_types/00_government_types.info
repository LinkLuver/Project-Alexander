name_of_government_type = {
	map_color = gov_monarchy					# named color used for this government on the political map. Defined in common/named_colors (see 02_map.txt)

	government_power = legitimacy				# which government power currency this type uses. One of: legitimacy, republican_tradition, devotion, horde_unity, tribal_cohesion. Default = legitimacy
												# each one maps to a monthly modifier (monthly_legitimacy, monthly_republican_tradition, monthly_devotion, monthly_horde_unity, monthly_tribal_cohesion)

	default_character_estate = nobles_estate	# the estate a character in this government's court belongs to when nothing else assigns one

	use_regnal_number = yes						# do rulers get regnal numbers after their name (Henry IV). Default = no
	generate_consorts = yes						# should a consort be generated for a ruler who has none. Default = no
	allows_noble_marriage = yes					# can the ruler or heir be married to a noble of their own court via the Marry a Noble action? Default = no
												# also settable on a heir selection (see common/heir_selections); either one granting it is enough

	revolutionary_country_antagonism = 20		# antagonism this government type generates towards revolutionary countries. Scaled by the antagonism_revolution_impact modifier. Default = 0

	heir_selection = salic_law					# a succession law available to this government type. Repeat the line once per law
	heir_selection = elective_succession		# only laws listed here can be picked, unless the bypass-requirements cheat is on

	modifier = {								# country modifier applied while this government type is active
		care_about_producing_heirs = yes
	}
}

# Localization, keyed off the government type name:
#   <key>		 the displayed name, e.g. monarchy: "Monarchy"
#   <key>_desc	 the description shown in the tooltip and government panel
# Both live in localization/english/government_names_l_english.yml
