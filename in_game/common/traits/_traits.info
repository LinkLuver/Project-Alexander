trait_name = {

	# Which type of character can use this trait? Default is "ruler".
	category = ruler/general/admiral/artist/explorer
	flavor = <trait flavor>

	allow = {
		# What else does the character need for this trait to be a valid choice?
	}
	
	modifier = {
		# What effect does this trait have when the character's role is the same as this trait's category?
	}

	chance = {
		# MTTH style of chance determining how likely this trait is to appear.
		# Supports base = N and modifier = { factor = M condition }. The result is bucketed to integers via GetCeiling(),
		# so fractional factor values below 1 do not demote the trait. Use the allow block above for exclusion.
	}

	# Health only: no birth roll if this many siblings have or ever had it
	max_number_of_birth_siblings = 2
}