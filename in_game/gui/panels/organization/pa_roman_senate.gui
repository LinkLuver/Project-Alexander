types OrganizationPanel {
	type pa_senate_country_agendas = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 4
		datamodel = "[Player.GetGovernment.GetEstates]"
		item = {
			card_header_button_01 = {
				layoutpolicy_horizontal = expanding
				size = { -1 40 }
				using = bg_card_list_action_disabled
				datacontext = "[Player.GetGovernment.GetParliament.GetCountryParliamentAgenda(Estate.GetType)]"
				visible = "[And(ActiveParliamentAgenda.GetAgenda.MakeScope.IsSet, Not(StringIsEmpty(ActiveParliamentAgenda.GetNameWithNoTooltip)))]"
				action_tooltip = {
					click_type = left
					click_mode = confirm
					title = "[ActiveParliamentAgenda.GetNameWithNoTooltip]"
					description = "[ActiveParliamentAgenda.GetAgenda.GetDescription]"
					on_action = "[GetScriptedGui('pa_senate_accept_estate_agenda').Execute(GuiScope.SetRoot(Player.MakeScope).AddScope('target', Estate.GetType.MakeScope).AddScope('agenda', ActiveParliamentAgenda.GetAgenda.MakeScope).End)]"
				}
				tooltipwidget = { using = action_tooltip_pop_out }
				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 4 }
					spacing = 8
					icon = { size = { 26 26 } texture = "[GetEstateIcon(Estate.GetType)]" }
					text_single = { layoutpolicy_horizontal = expanding align = left|vcenter text = "[ActiveParliamentAgenda.GetNameWithNoTooltip]" }
					icon = { size = { 20 20 } texture = "gfx/interface/icons/flat_icons/parliament_support.dds" }
				}
			}
		}
	}
	type pa_senate_native_request = card_header_button_01 {
		layoutpolicy_horizontal = expanding
		size = { -1 40 }
		visible = "[PdxGuiWidget.IsUberButtonVisible]"
		enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
		using = bg_card_list_action_disabled
		block "request_action" {}
		tooltipwidget = { using = action_tooltip_pop_out }
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 10 5 }
			spacing = 8
			text_single = { layoutpolicy_horizontal = expanding align = left|vcenter fontsize = 13 block "request_text" {} }
			text_single = { size = { 65 25 } using = bg_number_container_bckg text = "[Player.GetModifierValueNoSign('parliament_request_issue_support_needed')]" align = center block "request_cost_visible" {} }
			icon = { size = { 20 20 } texture = "gfx/interface/icons/flat_icons/parliament_support.dds" }
		}
	}
}

# Native Roman Senate tab for the international-organization panel.
# One compact Imperator-style composition: consuls, mandates, agenda and factions.
organization_panel = {
	blockoverride "organization_panel_overview_visible" { visible = "[And(And(InternationalOrganizationsView.Vars.NotExistOrHasValue('organizations', 'overview'), Or(InternationalOrganizationsView.HasOverview, InternationalOrganizationsView.HasActions)), Not(EqualTo_string(InternationalOrganizationsView.GetInternationalOrganization.GetType.GetNameKey, 'pa_roman_senate')))]" }
	blockoverride "organization_custom_tab_visible" { visible = "[EqualTo_string(InternationalOrganizationsView.GetInternationalOrganization.GetType.GetNameKey, 'pa_roman_senate')]" }
	blockoverride "organization_custom_tab_text" { text = "pa_senate_laws_tab" }
	blockoverride "organization_custom_content_visible" {
		visible = "[And(EqualTo_string(InternationalOrganizationsView.GetInternationalOrganization.GetType.GetNameKey, 'pa_roman_senate'), InternationalOrganizationsView.Vars.HasValue('organizations', 'custom'))]"
	}
	blockoverride "organization_laws_tab_visible" { visible = "[And(InternationalOrganizationsView.HasLaws, Not(EqualTo_string(InternationalOrganizationsView.GetInternationalOrganization.GetType.GetNameKey, 'pa_roman_senate')))]" }
	blockoverride "organization_custom_content" {
		scrollarea = {
			using = layoutpolicy_expanding
			scrollbarpolicy_horizontal = always_off
			scrollbar_vertical = { using = Scrollbar_Vertical }
			scrollwidget = {
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
			using = bg_paper_card
			using = bg_cabinet_card_frame
			hbox = {
				layoutpolicy_horizontal = expanding
				size = { -1 45 }
				using = bg_card_header_01_diplomacy
				using = bg_cabinet_card_frame
				margin = { 10 6 }
				spacing = 8
				icon = { size = { 28 28 } texture = "gfx/interface/icons/flat_icons/parliament.dds" }
				text_single = { text = "pa_senate_country_laws_title" default_format = "#yellow_titles" align = left|vcenter fontsize = 16 }
			}
			text_single = { text = "pa_senate_laws_description" align = center fontsize = 12 }
			button = { layoutpolicy_horizontal = expanding size = { -1 34 } using = button_regular_texture using = button_common_template visible = "[Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet]" onclick = "[GetScriptedGui('pa_senate_veto_ten_year_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_veto_bill" align = center fontsize = 12 } }
			text_single = { text = "pa_senate_measures_military" align = center default_format = "#yellow_titles" fontsize = 15 }
			button = { layoutpolicy_horizontal = expanding size = { -1 34 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_motion_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_propose_manpower_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_ten_year_manpower_button" align = center fontsize = 11 } }
			button = { layoutpolicy_horizontal = expanding size = { -1 34 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_motion_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_propose_levies_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_ten_year_levies_button" align = center fontsize = 11 } }
			text_single = { text = "pa_senate_measures_civil" align = center default_format = "#yellow_titles" fontsize = 15 }
			button = { layoutpolicy_horizontal = expanding size = { -1 34 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_motion_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_propose_works_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_ten_year_works_button" align = center fontsize = 11 } }
			button = { layoutpolicy_horizontal = expanding size = { -1 34 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_motion_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_propose_registers_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_ten_year_registers_button" align = center fontsize = 11 } }
			button = { layoutpolicy_horizontal = expanding size = { -1 34 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_motion_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_propose_holdings_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_ten_year_holdings_button" align = center fontsize = 11 } }
			text_single = { text = "pa_senate_measures_economic" align = center default_format = "#yellow_titles" fontsize = 15 }
			button = { layoutpolicy_horizontal = expanding size = { -1 34 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_motion_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_propose_tax_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_ten_year_tax_button" align = center fontsize = 11 } }
			button = { layoutpolicy_horizontal = expanding size = { -1 34 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_motion_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_propose_grain_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_ten_year_grain_button" align = center fontsize = 11 } }
			button = { layoutpolicy_horizontal = expanding size = { -1 34 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_motion_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_propose_farms_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_ten_year_farms_button" align = center fontsize = 11 } }
			button = { layoutpolicy_horizontal = expanding size = { -1 34 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_motion_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_propose_industry_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_ten_year_industry_button" align = center fontsize = 11 } }
			button = { layoutpolicy_horizontal = expanding size = { -1 34 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_motion_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_propose_aristocracy_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_ten_year_aristocracy_button" align = center fontsize = 11 } }
			button = { layoutpolicy_horizontal = expanding size = { -1 34 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_motion_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_propose_construction_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_ten_year_construction_button" align = center fontsize = 11 } }
			button = { layoutpolicy_horizontal = expanding size = { -1 34 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_motion_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_propose_distribution_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_ten_year_distribution_button" align = center fontsize = 11 } }
			button = { layoutpolicy_horizontal = expanding size = { -1 34 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_motion_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_propose_foodworks_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_ten_year_foodworks_button" align = center fontsize = 11 } }

		}
			}
		}
	}
	blockoverride "pa_senate_chambers_tab_visible" { visible = no }
	blockoverride "pa_senate_debate_header" {
					subheader = {
						layoutpolicy_vertical = fixed
						visible = "[Not(Player.GetGovernment.GetParliament.IsParliamentActive)]"
						hbox = {
							using = bg_paper_card
							using = bg_card_header_01
							blockoverride "header_color" {
								using = color_government_texture
							}
							using = bg_cabinet_card_frame
							margin = { 4 0 }
							card_header_button_01 = {
								size = {42 42}
								spriteborder = { 40 40 }
								datacontext = "[Player.GetGovernment.GetParliament.GetParliamentType]"
								visible = "[Not(Player.GetGovernment.GetParliament.IsParliamentActive)]"
								enabled = "[PdxGuiWidget.IsUberButtonEnabled]"

								scripted_action_tooltip = {
									click_type = left
									click_mode = single
									action_name = "change_parliament_type"
									actor = "[Player]"
								}

								tooltipwidget = {
									using = ParliamentType_tooltip
								}
								icon = {
									parentanchor = center
									size = { 30 30 }
									texture = "[GetParliamentTypeIcon(ParliamentType.Self)]"
								}
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 5
								tooltipmeta = {
									game_concept = "[parliament|e]"
								}
								
								card_header_button_01 = {
									layoutpolicy_horizontal = expanding
									size = {-1 42}
									spriteborder = { 40 40 }
									datacontext = "[Player]"
									visible = "[Not(Player.GetGovernment.GetParliament.IsParliamentActive)]"
									enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
									using = bg_card_header_01_government
									blockoverride "uiaction_gov" {
										visible = "[Not(PdxGuiWidget.IsUberButtonEnabled)]"
									}

									scripted_action_tooltip = {
										click_type = left
										click_mode = single
										action_name = "call_parliament"
										actor = "[Player]"
									}

									button_tooltip_override = { title = "pa_senate_call_native" }

									tooltipwidget = {
										using = action_tooltip_pop_out

										blockoverride "title_icon_texture" {
											texture = "gfx/interface/icons/flat_icons/parliament.dds"
										}
									}
									

									hbox = {
										layoutpolicy_horizontal = expanding
										margin = {10 0}
										icon = {
											size = { 22 22 }
											texture = "gfx/interface/icons/flat_icons/parliament.dds"
											datacontext = "[Player.GetGovernment.GetParliament.GetParliamentType]"
											tooltipwidget = {
												using = ParliamentType_tooltip
											}
										}
										vbox = {
											layoutpolicy_horizontal = expanding
											text_single = { layoutpolicy_horizontal = expanding align = center text = "pa_senate_call_native" default_format = "#yellow_titles" }
											text_single = { layoutpolicy_horizontal = expanding align = center fontsize = 11 text = "[Player.GetGovernment.GetParliament.GetLastParliamentCalledDate|F]" }
										}
									}
								}

								hbox = {
									using = bg_card_header_01
									visible = "[Not(Player.GetGovernment.GetParliament.IsParliamentActive)]"

									margin = {5 -1}
									size = {100 43}
									spacing = 5
									expand= {}
									vbox = {
										text_single = {
											text = "[parliament_base_support_short|e]"
											tooltipwidget = {
												using = parliament_base_support_tooltip
											}
											fontsize = 14
										}

										hbox = {
											layoutpolicy_horizontal = expanding
											expand= {}
											text_single = {
												text = "[Player.GetModifierValueNoFormat('parliament_base_support')]"
												tooltipwidget = {
													using = parliament_base_support_tooltip
												}
												fontsize = 12
											}
										}
									}
								}
							}
							piechart = {
								alwaystransparent = yes
								size = { 50 50 }

								using = piechart_angles

								using = bg_piechart_dark

								pieslice = {
									texture = "gfx/interface/pie_charts/pie_chart_blue_progress.dds"
									value = "[FixedPointToFloat(Player.GetModifierRawValue('parliament_base_support'))]"
									color = { 0.3 1 0.3 1 }
									alwaystransparent = yes
								}

								pieslice = {
									texture = "gfx/interface/pie_charts/pie_chart_blue_progress.dds"
									value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetModifierRawValue('parliament_base_support')))]"
									color = { 0.3 0.35 0.4 1 }
									alwaystransparent = yes
								}

								icon = {
									size = {70% 70%}
									parentanchor = center
									texture = "gfx/interface/icons/flat_icons/parliament_support.dds"
									glow = {
										name = "drop_shadow"
										glow_radius = 3
										color = {0.0 0.0 0.0 1.0}
										alpha = 0.3
									}
									tooltipwidget = {
										using = parliament_base_support_tooltip
									}
								}
							}
						}
					}
		subheader = {
			datacontext = "[Player]"
			layoutpolicy_vertical = fixed
			visible = "[And(Player.GetGovernment.GetParliament.HasOngoingParliamentDebate, Player.GetGovernment.GetParliament.IsParliamentActive)]"
			hbox = {
				using = bg_paper_card
				using = bg_card_header_01_government
				using = bg_cabinet_card_frame

				margin = { 4 0 }

				piechart = {
					visible = "[Player.GetGovernment.GetParliament.HasOngoingParliamentDebate]"
					size = { 50 50 }
					using = piechart_angles
					tooltipwidget = {
						using = ParliamentInSession_tooltip
					}

					using = bg_piechart_dark
					
					icon = {
						texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
						size = { 97% 97% }
						parentanchor = center
						color = { 0.45 0.59  0.67 1 }
						alpha = 0.3
					}
		
					pieslice_no_highlight = {
						texture = "gfx/interface/pie_charts/pie_chart_blue_progress.dds"
						value = "[Player.GetGovernment.GetParliament.GetParliamentDurationProgress]"
						color = { 1 1 1 1 }
					}
		
					pieslice_no_highlight = {
						texture = "gfx/interface/pie_charts/pie_chart_blue_progress.dds"
						value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetGovernment.GetParliament.GetParliamentDurationProgress))]"
						color = { 1 1 1 0 }
					}

					icon = {
						name = "plus"
						texture = "gfx/interface/icons/flat_icons/parliament.dds"
						size = { 58% 58% }
						using = overlay_color_light_green
						parentanchor = center
						visible = "[Player.GetGovernment.GetParliament.WillParliamentIssuePass]"
						datacontext = "[Player]"
						tooltipwidget = {
							SimpleContextualTooltipType = {
								blockoverride "title_icon_texture" {
									texture = "gfx/interface/icons/flat_icons/parliament.dds"
									using = overlay_color_light_green
								}

								lowpriotextcontext =  "PARLIAMENT_ISSUE_WILL_NOT_FAIL"
							}
						}
					}
					icon = {
						name = "minus"
						texture = "gfx/interface/icons/flat_icons/parliament.dds"
						size = { 58% 58% }
						using = overlay_color_red
						parentanchor = center
						visible = "[Not(Player.GetGovernment.GetParliament.WillParliamentIssuePass)]"
						datacontext = "[Player]"
						tooltipwidget = {
							SimpleContextualTooltipType = {
								blockoverride "title_icon_texture" {
									texture = "gfx/interface/icons/flat_icons/parliament.dds"
									using = overlay_color_red
								}
								lowpriotextcontext =  "PARLIAMENT_ISSUE_WILL_FAIL"
							}
						}
					}
					using = bg_circle_piechart
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 5
					hbox = {
						layoutpolicy_horizontal = expanding
						size = {-1 43}
						
						margin = {10 0 }
						vbox = {
							text_single = {
								text = "[Player.GetGovernment.GetParliament.GetCurrentDebateName]"
								default_format = "#yellow_titles"
								fontsize = 16
								maximumsize = {245 -1}
							}
							
							hbox = {
								layoutpolicy_horizontal = expanding
								text_single = {
									maximumsize = {245 -1}
									fontsize = 11
									visible = "[Player.GetGovernment.GetParliament.GetParliamentLocation.IsValid]"
									text = "PARLIAMENT_DURATION_TXT"
									tooltipwidget = {
										using = ParliamentInSession_tooltip
									}
								}
								text_single = {
									maximumsize = {245 -1}
									fontsize = 11
									visible = "[Not(Player.GetGovernment.GetParliament.GetParliamentLocation.IsValid)]"
									text = "PARLIAMENT_DURATION_TXT_NO_LOCATION"
									tooltipwidget = {
										using = ParliamentInSession_tooltip
									}
								}
								expand = {}
							}
						}
						expand = {}
						
					
						blockoverride "icon_texture" {}
					}

					hbox = {
						using = bg_text_mask_container_dark_blue
						# using = bg_card_header_01

						margin = {8 4}
						size = {100 43}
						spacing = 5
						expand= {}
						vbox = {
							text_single = {
								text = "[parliament_support|e]"
								tooltipwidget = {
									using = parliament_support_tooltip
								}
								fontsize = 14
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								expand= {}
								text_single = {
									text = "[Player.GetGovernment.GetParliament.GetParliamentIssueSupport|+%]"
									tooltipwidget = {
										using = parliament_support_tooltip
									}
									fontsize = 12
								}
							}
						}
					}
				}
				piechart = {
					visible = "[And(Player.GetGovernment.GetParliament.HasOngoingParliamentDebate, 
					GreaterThanOrEqualTo_CFixedPoint(Player.GetGovernment.GetParliament.GetParliamentIssueSupport, '(CFixedPoint)0.5'))]"
					size = { 50 50 }
					using = piechart_angles
					
					using = bg_piechart_dark

					pieslice = {
						texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
						value = "[Player.GetGovernment.GetParliament.GetBaseParliamentIssueSupport]"
						color = { 0.3 0.8 0.3 1 }
						alpha = 1
						
					}

					pieslice = {
						texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
						value = "[Player.GetGovernment.GetParliament.GetAddedParliamentIssueSupport]"
						color = { 0.3 0.8 0.3 1 }
						alpha = 0.8
						
					}

					pieslice = {
						texture = "gfx/interface/pie_charts/pie_chart_blue_progress.dds"
						value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetGovernment.GetParliament.GetParliamentIssueSupport))]"
						color = { 1 1 1 0 }
					}
					
					icon = {
						texture = "gfx/interface/icons/flat_icons/parliament_support.dds"
						size = { 45% 45% }
						parentanchor = center
					}
					tooltipwidget = {
						using = parliament_support_tooltip
					}
					using = bg_circle_piechart
				}

				piechart = {
					visible = "[And(Player.GetGovernment.GetParliament.HasOngoingParliamentDebate, 
					LessThan_CFixedPoint(Player.GetGovernment.GetParliament.GetParliamentIssueSupport, '(CFixedPoint)0.5'))]"
					size = { 50 50 }
					using = piechart_angles
					
					using = bg_piechart_dark

					pieslice = {
						texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
						value = "[Player.GetGovernment.GetParliament.GetBaseParliamentIssueSupport]"
						color = { 1 1 1 1 }
						alpha = 1
						
					}

					pieslice = {
						texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
						value = "[Player.GetGovernment.GetParliament.GetAddedParliamentIssueSupport]"
						color = { 1 1 1 1 }
						alpha = 0.8
						
					}

					pieslice = {
						texture = "gfx/interface/pie_charts/pie_chart_blue_progress.dds"
						value = "[Subtract_float('(float)1.0', FixedPointToFloat(Player.GetGovernment.GetParliament.GetParliamentIssueSupport))]"
						color = { 1 1 1 0 }
					}
					
					icon = {
						texture = "gfx/interface/icons/flat_icons/parliament_support.dds"
						size = { 45% 45% }
						parentanchor = center
					}
					tooltipwidget = {
						using = parliament_support_tooltip
					}
					using = bg_circle_piechart
				}
			}
		}
	}
	blockoverride "pa_senate_parliament_content" {
		scrollarea = {
			visible = "[EqualTo_string(InternationalOrganizationsView.GetInternationalOrganization.GetType.GetNameKey, 'pa_roman_senate')]"
			using = layoutpolicy_expanding
			scrollbarpolicy_horizontal = always_off
			scrollbar_vertical = { using = Scrollbar_Vertical }
			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 1
					text_single = { text = "pa_senate_chambers_title" align = center default_format = "#yellow_titles" fontsize = 18 }
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { layoutpolicy_horizontal = expanding text = "pa_senate_authority" align = center fontsize = 11 }
						text_single = { layoutpolicy_horizontal = expanding text = "pa_senate_tyranny" align = center fontsize = 11 }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
