								hbox = {
									layoutpolicy_horizontal = expanding
									vbox = {
											size = { 93 -1 }
										text_single = { visible = "[Not(Player.MakeScope.GetVariable('pa_roman_dictatorship_active').IsSet)]" text = "pa_senate_consul_card_title" align = center default_format = "#yellow_titles" fontsize = 11 }
										text_single = { visible = "[Player.MakeScope.GetVariable('pa_roman_dictatorship_active').IsSet]" text = "pa_roman_dictator_title" align = center default_format = "#yellow_titles" fontsize = 11 }
										widget = { size = { 93 54 } character_frame_medium = { parentanchor = center size = { 44 54 } blockoverride "portrait_datacontext" { datacontext = "[Player.GetGovernment.GetRulerOrRegent]" } blockoverride "estate_icon" { visible = no } blockoverride "dynasty_shield" {} } }
										text_single = { size = { 94 16 } text = "[Player.GetGovernment.GetRulerOrRegent.GetShortNameWithNoTooltip]" align = center autoresize = yes fontsize = 10 }
									}
									vbox = {
										size = { 93 -1 }
										text_single = { visible = "[Not(Player.MakeScope.GetVariable('pa_roman_dictatorship_active').IsSet)]" text = "pa_senate_co_consul_card_title" align = center default_format = "#yellow_titles" fontsize = 11 }
										widget = { size = { 93 54 } character_frame_medium = { parentanchor = center visible = "[Player.MakeScope.GetVariable('pa_senate_co_consul').IsSet]" size = { 44 54 } blockoverride "portrait_datacontext" { datacontext = "[Player.MakeScope.GetVariable('pa_senate_co_consul').GetCharacter]" } blockoverride "estate_icon" { visible = no } blockoverride "dynasty_shield" {} } }
										text_single = { size = { 94 16 } visible = "[Player.MakeScope.GetVariable('pa_senate_co_consul').IsSet]" text = "[Player.MakeScope.GetVariable('pa_senate_co_consul').GetCharacter.GetShortNameWithNoTooltip]" align = center autoresize = yes fontsize = 10 }
									}
								}
								text_single = { text = "pa_senate_current_backing" align = center default_format = "#yellow_titles" fontsize = 11 }
								widget = {
									layoutpolicy_horizontal = expanding
									size = { -1 14 }
									progressbar = { parentanchor = center size = { 160 12 } using = morale_progressbar_bar value = "[Multiply_float(FixedPointToFloat(Player.MakeScope.ScriptValue('pa_senate_approval_share')), '(float)100')]" }
								}
								text_single = { text = "[Player.MakeScope.ScriptValue('pa_senate_approval_share')|2%]" align = center fontsize = 11 }
							}
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						widget = { layoutpolicy_horizontal = fixed size = { 33% 18 } hbox = { parentanchor = center icon = { size = { 18 18 } texture = "gfx/interface/icons/party_types/optimates_party.dds" } text_single = { text = "pa_senate_optimates" fontsize = 11 } } }
						widget = { layoutpolicy_horizontal = fixed size = { 33% 18 } hbox = { parentanchor = center icon = { size = { 18 18 } texture = "gfx/interface/icons/party_types/boni_party.dds" } text_single = { text = "pa_senate_boni" fontsize = 11 } } }
						widget = { layoutpolicy_horizontal = fixed size = { 33% 18 } hbox = { parentanchor = center icon = { size = { 18 18 } texture = "gfx/interface/icons/party_types/populares_party.dds" } text_single = { text = "pa_senate_populares" fontsize = 11 } } }
					}
