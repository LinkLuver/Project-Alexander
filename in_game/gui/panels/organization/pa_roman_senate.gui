					hbox = {
						layoutpolicy_horizontal = expanding
						widget = { layoutpolicy_horizontal = fixed size = { 33% 54 } character_frame_medium = { parentanchor = center size = { 44 54 } visible = "[Player.MakeScope.GetVariable('pa_senate_optimates_leader').IsSet]" blockoverride "portrait_datacontext" { datacontext = "[Player.MakeScope.GetVariable('pa_senate_optimates_leader').GetCharacter]" } blockoverride "estate_icon" { visible = no } blockoverride "dynasty_shield" {} } }
						widget = { layoutpolicy_horizontal = fixed size = { 33% 54 } character_frame_medium = { parentanchor = center size = { 44 54 } visible = "[Player.MakeScope.GetVariable('pa_senate_boni_leader').IsSet]" blockoverride "portrait_datacontext" { datacontext = "[Player.MakeScope.GetVariable('pa_senate_boni_leader').GetCharacter]" } blockoverride "estate_icon" { visible = no } blockoverride "dynasty_shield" {} } }
						widget = { layoutpolicy_horizontal = fixed size = { 33% 54 } character_frame_medium = { parentanchor = center size = { 44 54 } visible = "[Player.MakeScope.GetVariable('pa_senate_populares_leader').IsSet]" blockoverride "portrait_datacontext" { datacontext = "[Player.MakeScope.GetVariable('pa_senate_populares_leader').GetCharacter]" } blockoverride "estate_icon" { visible = no } blockoverride "dynasty_shield" {} } }
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						text_single = { text = "pa_senate_agenda" align = center default_format = "#yellow_titles" fontsize = 12 }
						button = { layoutpolicy_horizontal = expanding size = { -1 30 } using = button_regular_texture using = button_common_template visible = "[Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet]" onclick = "[GetScriptedGui('pa_senate_veto_ten_year_measure').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_veto_bill" align = center fontsize = 11 } }
						text_single = { layoutpolicy_horizontal = expanding visible = "[And(Not(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet), Not(Or(Or(Or(Player.MakeScope.GetVariable('pa_senate_agenda_stability').IsSet, Player.MakeScope.GetVariable('pa_senate_agenda_holdings').IsSet), Or(Player.MakeScope.GetVariable('pa_senate_agenda_works').IsSet, Player.MakeScope.GetVariable('pa_senate_agenda_law').IsSet)), Or(Player.MakeScope.GetVariable('pa_senate_agenda_war').IsSet, Player.MakeScope.GetVariable('pa_senate_agenda_alliance').IsSet))))]" text = "pa_senate_no_agenda" align = center fontsize = 11 }
						text_single = { visible = "[And(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').GetValue, '(CFixedPoint)1'))]" text = "pa_senate_ten_year_tax_button" align = center fontsize = 11 }
						text_single = { visible = "[And(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').GetValue, '(CFixedPoint)2'))]" text = "pa_senate_ten_year_manpower_button" align = center fontsize = 11 }
						text_single = { visible = "[And(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').GetValue, '(CFixedPoint)3'))]" text = "pa_senate_ten_year_grain_button" align = center fontsize = 11 }
						text_single = { visible = "[And(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').GetValue, '(CFixedPoint)4'))]" text = "pa_senate_ten_year_farms_button" align = center fontsize = 11 }
						text_single = { visible = "[And(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').GetValue, '(CFixedPoint)5'))]" text = "pa_senate_ten_year_works_button" align = center fontsize = 11 }
						text_single = { visible = "[And(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').GetValue, '(CFixedPoint)6'))]" text = "pa_senate_ten_year_industry_button" align = center fontsize = 11 }
						text_single = { visible = "[And(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').GetValue, '(CFixedPoint)7'))]" text = "pa_senate_ten_year_aristocracy_button" align = center fontsize = 11 }
						text_single = { visible = "[And(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').GetValue, '(CFixedPoint)8'))]" text = "pa_senate_ten_year_levies_button" align = center fontsize = 11 }
						text_single = { visible = "[And(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').GetValue, '(CFixedPoint)9'))]" text = "pa_senate_ten_year_registers_button" align = center fontsize = 11 }
						text_single = { visible = "[And(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').GetValue, '(CFixedPoint)10'))]" text = "pa_senate_ten_year_construction_button" align = center fontsize = 11 }
						text_single = { visible = "[And(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').GetValue, '(CFixedPoint)11'))]" text = "pa_senate_ten_year_distribution_button" align = center fontsize = 11 }
						text_single = { visible = "[And(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').GetValue, '(CFixedPoint)12'))]" text = "pa_senate_ten_year_foodworks_button" align = center fontsize = 11 }
						text_single = { visible = "[And(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_ten_year_proposal').GetValue, '(CFixedPoint)13'))]" text = "pa_senate_ten_year_holdings_button" align = center fontsize = 11 }
						text_single = { visible = "[Player.MakeScope.GetVariable('pa_senate_agenda_stability').IsSet]" text = "pa_senate_agenda_stability_name" align = center fontsize = 11 }
						text_single = { visible = "[Player.MakeScope.GetVariable('pa_senate_agenda_stability').IsSet]" text = "pa_senate_agenda_stability_effects" align = center fontsize = 11 }
						text_single = { visible = "[Player.MakeScope.GetVariable('pa_senate_agenda_holdings').IsSet]" text = "pa_senate_agenda_holdings_name" align = center fontsize = 11 }
						text_single = { visible = "[Player.MakeScope.GetVariable('pa_senate_agenda_holdings').IsSet]" text = "pa_senate_agenda_holdings_effects" align = center fontsize = 11 }
						text_single = { visible = "[Player.MakeScope.GetVariable('pa_senate_agenda_works').IsSet]" text = "pa_senate_agenda_works_name" align = center fontsize = 11 }
						text_single = { visible = "[Player.MakeScope.GetVariable('pa_senate_agenda_works').IsSet]" text = "pa_senate_agenda_works_effects" align = center fontsize = 11 }
						text_single = { visible = "[And(Player.MakeScope.GetVariable('pa_senate_agenda_law').IsSet, Not(Player.MakeScope.GetVariable('pa_senate_proposed_policy').IsSet))]" text = "pa_senate_agenda_law_name" align = center fontsize = 11 }
						vbox = {
							visible = "[And(Player.MakeScope.GetVariable('pa_senate_agenda_law').IsSet, Player.MakeScope.GetVariable('pa_senate_proposed_policy').IsSet)]"
							datacontext = "[Player.MakeScope.GetVariable('pa_senate_proposed_policy').GetPolicy]"
							layoutpolicy_horizontal = expanding
							text_single = { text = "[Policy.GetLaw.GetNameWithNoTooltip]" align = center fontsize = 11 }
							text_single = { text = "[Policy.GetNameWithNoTooltip]" align = center fontsize = 11 }
							text_single = { text = "[Policy.GetModifierTextFor(Player.Self)]" align = center autoresize = yes fontsize = 10 }
						}
						text_single = { visible = "[Player.MakeScope.GetVariable('pa_senate_agenda_war').IsSet]" text = "pa_senate_agenda_war_name" align = center fontsize = 11 }
						text_single = { visible = "[Player.MakeScope.GetVariable('pa_senate_agenda_alliance').IsSet]" text = "pa_senate_agenda_alliance_name" align = center fontsize = 11 }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4
						button = { layoutpolicy_horizontal = expanding size = { -1 31 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_concession_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_favor_optimates').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_favor_optimates" align = center fontsize = 10 } }
						button = { layoutpolicy_horizontal = expanding size = { -1 31 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_concession_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_favor_boni').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_favor_boni" align = center fontsize = 10 } }
						button = { layoutpolicy_horizontal = expanding size = { -1 31 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_concession_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_favor_populares').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_favor_populares" align = center fontsize = 10 } }
					}
					card_expandable = {
						visible = no
						layoutpolicy_horizontal = expanding
						blockoverride "bg_expandable_color" {
							using = bg_card_header_01_government
						}
						blockoverride "header_content" {
							button = {
								layoutpolicy_horizontal = expanding
								size = { -1 40 }
								action_tooltip = {
									title = "game_concept_parliament_requests"
									on_action = "[InternationalOrganizationsView.Vars.Toggle( 'pa_senate_requests_collapsed' )]"
								}
								tooltipwidget = {
									BasicFunctionalTooltip = {}
								}
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4
									icon = {
										size = { 30 30 }
										texture = "gfx/interface/icons/flat_icons/parliament_request.dds"
										texture_density = 2
									}
									text_single = {
										text = "game_concept_parliament_requests"
									}
									expand = {}
								}
							}
						}
						blockoverride "header_button_onclick" {
							action_tooltip = {
								title = "game_concept_parliament_requests"
								on_action = "[InternationalOrganizationsView.Vars.Toggle( 'pa_senate_requests_collapsed' )]"
							}
							tooltipwidget = {
								BasicFunctionalTooltip = {}
							}
						}
						blockoverride "bottom_content_onclick" {
							visible = "[Not(InternationalOrganizationsView.Vars.Exists( 'pa_senate_requests_collapsed' ))]"
						}
						blockoverride "icon_replace_visible_yes" {
							visible = "[Not(InternationalOrganizationsView.Vars.Exists( 'pa_senate_requests_collapsed' ))]"
						}
						blockoverride "icon_replace_visible_not" {
							visible = "[InternationalOrganizationsView.Vars.Exists( 'pa_senate_requests_collapsed' )]"
						}
						blockoverride "bottom_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 5
								pa_senate_native_request = { blockoverride "request_action" { scripted_action_tooltip = { click_type = left click_mode = single action_name = "request_more_taxes" actor = "[Player]" } } blockoverride "request_text" { text = "[GetGenericAction('request_more_taxes').GetNameWithNoTooltip]" } }
								pa_senate_native_request = { blockoverride "request_action" { scripted_action_tooltip = { click_type = left click_mode = single action_name = "prepare_for_war" actor = "[Player]" } } blockoverride "request_text" { text = "[GetGenericAction('prepare_for_war').GetNameWithNoTooltip]" } }
								pa_senate_native_request = { blockoverride "request_action" { scripted_action_tooltip = { click_type = left click_mode = single action_name = "ask_for_larger_levies" actor = "[Player]" } } blockoverride "request_text" { text = "[GetGenericAction('ask_for_larger_levies').GetNameWithNoTooltip]" } }
								pa_senate_native_request = { blockoverride "request_action" { scripted_action_tooltip = { click_type = left click_mode = single action_name = "ask_for_law_changes" actor = "[Player]" } } blockoverride "request_text" { text = "[GetGenericAction('ask_for_law_changes').GetNameWithNoTooltip]" } }
								pa_senate_native_request = { blockoverride "request_action" { scripted_action_tooltip = { click_type = left click_mode = single action_name = "force_parliament_issue" actor = "[Player]" } } blockoverride "request_text" { text = "[GetGenericAction('force_parliament_issue').GetNameWithNoTooltip]" } blockoverride "request_cost_visible" { visible = no } }
							}
						}
					}
					card_expandable = {
						visible = no
						layoutpolicy_horizontal = expanding
						blockoverride "bg_expandable_color" {
							using = bg_card_header_01_government
						}
						blockoverride "header_content" {
							button = {
								layoutpolicy_horizontal = expanding
								size = { -1 40 }
								action_tooltip = {
									title = "game_concept_parliament_agendas"
									on_action = "[InternationalOrganizationsView.Vars.Toggle( 'pa_senate_agendas_collapsed' )]"
								}
								tooltipwidget = {
									BasicFunctionalTooltip = {}
								}
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4
									icon = {
										size = { 30 30 }
										texture = "gfx/interface/icons/flat_icons/estates_agenda.dds"
										texture_density = 2
									}
									text_single = {
										text = "game_concept_parliament_agendas"
									}
									expand = {}
								}
							}
						}
						blockoverride "header_button_onclick" {
							action_tooltip = {
								title = "game_concept_parliament_agendas"
								on_action = "[InternationalOrganizationsView.Vars.Toggle( 'pa_senate_agendas_collapsed' )]"
							}
							tooltipwidget = {
								BasicFunctionalTooltip = {}
