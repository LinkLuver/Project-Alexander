				}
			}
		}
	}

	blockoverride "organization_parliament_tab_text" {
		text = "[SelectLocalization(EqualTo_string(InternationalOrganizationsView.GetInternationalOrganization.GetType.GetNameKey, 'pa_roman_senate'), 'pa_senate_io_tab', 'game_concept_parliament')]"
	}

	blockoverride "pa_senate_chambers_content" {
		scrollarea = {
			visible = no
			using = layoutpolicy_expanding
			scrollbarpolicy_horizontal = always_off
			scrollbar_vertical = { using = Scrollbar_Vertical }
			scrollwidget = {
		vbox = {
			using = layoutpolicy_expanding
			spacing = 4

			# Authority and tyranny are kept inside the header instead of clipping.
			header_paper_card_horizontal = {
				layoutpolicy_horizontal = expanding
				size = { -1 50 }
				using = bg_paper_card
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 5
					icon = { texture = "gfx/interface/icons/shared_icons/senate_power.dds" size = { 32 32 } }
					vbox = {
						layoutpolicy_horizontal = expanding
						text_single = { text = "pa_senate_io_title" default_format = "#yellow_titles" fontsize = 16 }
						text_single = { text = "pa_senate_io_subtitle" fontsize = 10 }
					}
					vbox = {
						size = { 96 -1 }
						text_single = { text = "pa_senate_authority" align = right autoresize = yes fontsize = 9 }
						text_single = { text = "pa_senate_tyranny" align = right autoresize = yes fontsize = 9 }
					}
				}
			}

			# Each consul has a separate side of the curia; no central text overlap.
			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 148 }
				background = { texture = "gfx/interface/event_window/Event_senate_chamber.dds" texture_density = 2 }
				hbox = {
					size = { 100% 100% }
					layoutpolicy_horizontal = expanding
					spacing = 4
					vbox = {
						size = { 92 -1 }
						text_single = { text = "pa_senate_consul_card_title" align = center default_format = "#yellow_titles" fontsize = 12 }
						character_frame_medium = {
							size = { 58 72 }
							blockoverride "portrait_datacontext" { datacontext = "[Player.GetGovernment.GetRulerOrRegent]" }
							blockoverride "estate_icon" { visible = no }
							blockoverride "dynasty_shield" {}
						}
						hbox = { size = { -1 18 } using = bg_card_header_01_government text_single = { text = "pa_senate_primary_consul" align = center autoresize = yes fontsize = 9 } }
					}
					widget = { layoutpolicy_horizontal = expanding }
					vbox = {
						size = { 92 -1 }
						text_single = { text = "pa_senate_co_consul_card_title" align = center default_format = "#yellow_titles" fontsize = 12 }
						character_frame_medium = {
							visible = "[Player.MakeScope.GetVariable('pa_senate_co_consul').IsSet]"
							size = { 58 72 }
							blockoverride "portrait_datacontext" { datacontext = "[Player.MakeScope.GetVariable('pa_senate_co_consul').GetCharacter]" }
							blockoverride "estate_icon" { visible = no }
							blockoverride "dynasty_shield" {}
						}
						hbox = { size = { -1 18 } using = bg_card_header_01_government text_single = { text = "pa_senate_co_consul" align = center autoresize = yes fontsize = 9 } }
					}
				}
			}

			# War and alliance need Senate mandates. Trade is intentionally excluded.

			subheader = {
				hbox = {
					text_single = { layoutpolicy_horizontal = expanding text = "pa_senate_agenda" align = center default_format = "#yellow_titles" fontsize = 12 }
					widget = { layoutpolicy_horizontal = expanding }
					text_single = { visible = "[Player.MakeScope.GetVariable('pa_senate_agenda_stability').IsSet]" text = "pa_senate_agenda_stability_name" align = right autoresize = yes fontsize = 9 }
					text_single = { visible = "[Player.MakeScope.GetVariable('pa_senate_agenda_holdings').IsSet]" text = "pa_senate_agenda_holdings_name" align = right autoresize = yes fontsize = 9 }
					text_single = { visible = "[Player.MakeScope.GetVariable('pa_senate_agenda_works').IsSet]" text = "pa_senate_agenda_works_name" align = right autoresize = yes fontsize = 9 }
					text_single = { visible = "[Player.MakeScope.GetVariable('pa_senate_agenda_law').IsSet]" text = "pa_senate_agenda_law_name" align = right autoresize = yes fontsize = 9 }
					text_single = { visible = "[Player.MakeScope.GetVariable('pa_senate_agenda_war').IsSet]" text = "pa_senate_agenda_war_name" align = right autoresize = yes fontsize = 9 }
					text_single = { visible = "[Player.MakeScope.GetVariable('pa_senate_agenda_alliance').IsSet]" text = "pa_senate_agenda_alliance_name" align = right autoresize = yes fontsize = 9 }
				}
			}
			text_single = { text = "pa_senate_size" align = center fontsize = 11 }
			text_single = { text = "pa_senate_support_meter_label" align = center default_format = "#yellow_titles" fontsize = 12 }
			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 16 }
				visible = "[And(Player.MakeScope.GetVariable('pa_senate_initialized').IsSet, GreaterThanOrEqualTo_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_size').GetValue, '(CFixedPoint)1'))]"
				progressbar = {
					parentanchor = center
					size = { 240 14 }
					using = morale_progressbar_bar
					value = "[Multiply_float(FixedPointToFloat(Divide_CFixedPoint(Player.MakeScope.GetVariable('pa_senate_last_vote').GetValue, Player.MakeScope.GetVariable('pa_senate_size').GetValue)), '(float)100')]"
				}
			}
			text_single = { text = "[SelectLocalization( Player.MakeScope.GetVariable('pa_senate_initialized').IsSet, 'pa_senate_vote_result', 'pa_senate_initializing' )]" align = center fontsize = 11 }

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4
				button = { layoutpolicy_horizontal = expanding size = { -1 23 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_concession_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_favor_optimates').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_favor_optimates" align = center fontsize = 9 } }
				button = { layoutpolicy_horizontal = expanding size = { -1 23 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_concession_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_favor_boni').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_favor_boni" align = center fontsize = 9 } }
				button = { layoutpolicy_horizontal = expanding size = { -1 23 } using = button_regular_texture using = button_common_template enabled = "[Not(Player.MakeScope.GetVariable('pa_senate_concession_cooldown').IsSet)]" onclick = "[GetScriptedGui('pa_senate_favor_populares').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" text_single = { parentanchor = center text = "pa_senate_favor_populares" align = center fontsize = 9 } }
			}

